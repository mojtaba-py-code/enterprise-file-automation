# Copy to .env and fill in. Loaded automatically at startup by python-dotenv.
# Secrets live here, never in config/config.yaml and never in git.
#
# Every name below is the DEFAULT the config looks up. If you rename a variable,
# point config.yaml at the new name via encrypt.key_env / email.username_env /
# email.password_env rather than editing the code.

# Fernet key used when encrypt.enabled is true in config.yaml.
# Generate one with:  file-automation keygen
# Required only when encryption is enabled; the run aborts if it is missing.
FILE_AUTOMATION_ENCRYPTION_KEY=

# SMTP credentials, used only when email.enabled is true in config.yaml.
# The host, port, sender and recipients are plain settings and belong in
# config.yaml; only these two are secret.
FILE_AUTOMATION_SMTP_USERNAME=
FILE_AUTOMATION_SMTP_PASSWORD=
